NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=https://hosting-contoh.com
PANEL_URL=https://panel-contoh.com
PLTA=isi_application_api_key_di_sini
PLTC=isi_client_api_key_di_sini
TELEGRAM_BOT_TOKEN=isi_token_bot_telegram
TELEGRAM_OWNER_ID=123456789
TELEGRAM_WEBHOOK_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
DATABASE_URL=postgres://user:password@localhost:5432/gibran_panel
SESSION_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
OWNER_EMAIL=owner@example.com
# IDs konfigurasi Pterodactyl yang telah diverifikasi owner:
PTERO_LOCATION_ID=1
PTERO_EGG_ID=1
PTERO_NEST_ID=1
PTERO_DOCKER_IMAGE=ghcr.io/parkervcp/yolks:nodejs_20
PTERO_STARTUP=if [[ -d .git ]] && [[ {{AUTO_UPDATE}} == "1" ]]; then git pull; fi; npm install; node index.js
PTERO_ALLOWED_LOCATIONS=1
PTERO_ALLOWED_EGGS=1
MAX_RAM_MB=8192
MAX_CPU_PERCENT=400
MAX_DISK_MB=20480
ALLOW_UNLIMITED=false
# Comma-separated options presented to users:
RAM_OPTIONS_GB=1,2,3,4,5,6,8
CPU_OPTIONS=50,100,150,200,300,400
DISK_OPTIONS_GB=2,5,10,15,20
